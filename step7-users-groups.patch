diff --git a/src/main/resources/db/migration/V4__users_email_unique_active.sql b/src/main/resources/db/migration/V4__users_email_unique_active.sql
new file mode 100644
index 0000000..2deb899
--- /dev/null
+++ b/src/main/resources/db/migration/V4__users_email_unique_active.sql
@@ -0,0 +1,9 @@
+-- Users can now be (soft-)deleted through the API (UC-201). The plain UNIQUE
+-- constraint on users.email also counts soft-deleted rows, so the email of a
+-- removed user could never be reused (and the insert would fail with a 500, since
+-- the application-level check ignores deleted users). Uniqueness is enforced on
+-- active users only.
+
+ALTER TABLE users DROP CONSTRAINT IF EXISTS users_email_key;
+
+CREATE UNIQUE INDEX uq_users_email_active ON users (email) WHERE is_deleted = FALSE;
diff --git a/src/test/java/com/crmapp/backend/identity/controller/TeamManagementIntegrationTest.java b/src/test/java/com/crmapp/backend/identity/controller/TeamManagementIntegrationTest.java
