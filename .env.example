# Copy this file to ".env" (not committed) and adjust if needed.
# These values are read both by docker-compose.yml and by application.yml.

DB_NAME=crm_db
DB_USER=crm_user
DB_PASSWORD=crm_password
DB_HOST=127.0.0.1
DB_PORT=55432

SERVER_PORT=8181

JWT_SECRET=dev-only-change-this-jwt-secret-key-before-deploying-to-any-real-environment
JWT_EXPIRATION_MS=86400000